#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1
start_service() {
    [ -f /etc/haimababi-bridge.conf ] && . /etc/haimababi-bridge.conf
    procd_open_instance
    procd_set_param command /usr/bin/python3 /mnt/storage/haimababi-bridge/service.py
    procd_set_param env "HAIMA_CAMERA_IP=${HAIMA_CAMERA_IP:-}" "HAIMA_P2P_NAME=${HAIMA_P2P_NAME:-}"
    procd_set_param respawn 3600 5 10
    procd_set_param stderr 1
    procd_close_instance
}
