#!/bin/sh /etc/rc.common
START=97
USE_PROCD=1
start_service() {
    [ -f /etc/feeding-web/service.conf ] && . /etc/feeding-web/service.conf
    procd_open_instance
    procd_set_param command /usr/bin/python3 -u /etc/feeding-web/server.py --bind "${BIND:-127.0.0.1}" --port "${PORT:-8765}" --db /etc/feeding-web/data/feeding.sqlite3
    [ -n "$SITE_TITLE" ] && procd_append_param command --site-title "$SITE_TITLE"
    [ -n "$BIRTH_DATE" ] && procd_append_param command --birth-date "$BIRTH_DATE"
    if [ -n "$BOLOLO_MAC" ]; then
        procd_append_param command --bololo-mac "$BOLOLO_MAC" --bololo-client /etc/bololo/read_status.py --bololo-session /etc/bololo/session.json
        [ -n "$BOLOLO_MQTT_HOST" ] && procd_append_param command --bololo-mqtt-host "$BOLOLO_MQTT_HOST" --bololo-device-id "$BOLOLO_DEVICE_ID"
        [ "$BOLOLO_WEIGH" = 1 ] && procd_append_param command --bololo-weigh
    fi
    [ "$CAMERA_SLEEP" = 1 ] && procd_append_param command --camera-sleep
    procd_set_param respawn 3600 5 10
    procd_set_param stderr 1
    procd_close_instance
}
